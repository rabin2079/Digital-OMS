# ── Supabase ──────────────────────────────────────────────
# Project URL and keys from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to browser

# ── Admin auth ────────────────────────────────────────────
# Random 32+ char secret used to sign admin session cookies (e.g. `openssl rand -hex 32`)
AUTH_SECRET=change-me-to-a-long-random-string

# Initial admin account (used only by `npm run seed:admin`)
ADMIN_EMAIL=mail@digitalsolutionnepal.com
ADMIN_INITIAL_PASSWORD=set-a-temporary-password-here

# ── Site / contact ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://idp.digitalsolutionnepal.com
# WhatsApp number in international format without "+" (e.g. 9779800000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=mail@digitalsolutionnepal.com
