generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }

enum OrderStatus { NEW PROCESSING DOCUMENT_PENDING PAYMENT_PENDING READY_TO_DELIVER DELIVERED COMPLETED CANCELLED }
enum PaymentStatus { UNPAID PARTIAL PAID }
enum DeliveryStatus { PENDING READY DELIVERED }
enum PaymentMethod { CASH BANK_TRANSFER ESEWA KHALTI IME_PAY NEPALPAY_QR FONEPAY_QR OTHER }

model User {
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String
  name String?
  createdAt DateTime @default(now())
}
model Customer {
  id Int @id @default(autoincrement())
  name String
  phone String
  whatsapp String
  email String?
  address String?
  notes String?
  createdAt DateTime @default(now())
  orders Order[]
}
model Service {
  id Int @id @default(autoincrement())
  name String
  category String
  description String?
  basePrice Float?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  orders Order[]
}
model Order {
  id Int @id @default(autoincrement())
  orderCode String @unique
  customerId Int
  serviceId Int
  customPrice Float
  status OrderStatus @default(NEW)
  paymentStatus PaymentStatus @default(UNPAID)
  deliveryStatus DeliveryStatus @default(PENDING)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields:[customerId], references:[id])
  service Service @relation(fields:[serviceId], references:[id])
  payments Payment[]
  files UploadedFile[]
}
model Payment {
  id Int @id @default(autoincrement())
  orderId Int
  amount Float
  method PaymentMethod
  paymentDate DateTime
  screenshotPath String?
  notes String?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId], references:[id])
}
model UploadedFile {
  id Int @id @default(autoincrement())
  orderId Int
  filePath String
  fileType String
  note String?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId], references:[id])
}
model Setting {
  id Int @id @default(1)
  companyName String @default("Digital Solution Pvt. Ltd.")
  whatsappNumber String @default("")
  nepaliYearShort String @default("83")
  nepaliMonthNumber String @default("1")
}
